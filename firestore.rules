rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // NOTE: lecturer access is no longer gated by an email domain. Access is
    // granted by completing the sign-up flow with a valid, admin-issued course
    // code (stored in `course_codes`) + OTP verification.

    // A signed-in user counts as a lecturer when their lecturers/{uid}
    // profile exists and carries role == "lecturer". Used to grant the web
    // dashboard read access to students, questions and tracking data.
    function isLecturer() {
      return signedIn()
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        && get(/databases/$(database)/documents/lecturers/$(request.auth.uid)).data.role == "lecturer";
    }

    function isValidPublicProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'score',
        'computerArchitecturePoints',
        'computerNetworkingPoints',
        'softwareEngineeringPoints',
        'streakNumber',
        'badges',
        'selectedBadges',
        'avatarUrl',
        'createdAt',
        'updatedAt',
      ])
      && request.resource.data.displayName is string
      && request.resource.data.score is int
      && request.resource.data.computerArchitecturePoints is int
      && request.resource.data.computerNetworkingPoints is int
      && request.resource.data.softwareEngineeringPoints is int
      && request.resource.data.streakNumber is int
      && request.resource.data.badges is list
      && request.resource.data.selectedBadges is list
      && request.resource.data.avatarUrl is string;
    }

    // ---------------------------------------------------------------------
    // Lecturers collection (web dashboard)
    //
    // A lecturer profile is created by the web app ONLY after the sign-up OTP
    // has been verified, at which point `emailVerified` is true. Owners manage
    // their own profile (rename, course changes from settings, etc.).
    // ---------------------------------------------------------------------
    match /lecturers/{lecturerId} {
      allow create: if isOwner(lecturerId)
        && request.resource.data.role == "lecturer"
        && request.resource.data.emailVerified == true;
      allow read, update, delete: if isOwner(lecturerId);
    }

    // ---------------------------------------------------------------------
    // Course codes (sign-up invitation codes)
    //
    // Each doc is { code, course } (e.g. { code: "CA001", course:
    // "computer_architecture" }). `course_codes` must be readable without auth
    // because the sign-up form validates the code before the Firebase auth
    // account exists. Codes are admin-issued; seed them via the Firebase
    // Console / CLI. Updates only allow claiming a code (claimedBy) — the
    // code -> course mapping itself can never be changed from the client.
    // ---------------------------------------------------------------------
    match /course_codes/{codeId} {
      allow read: if true;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.course == resource.data.course;
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Lecturer OTP verification (in-flight sign-ups)
    //
    // Created right after createUserWithEmailAndPassword, read while the
    // lecturer enters the emailed code, updated on retries/resends, deleted
    // once verified. Owner-only so OTP hashes cannot be read by others.
    // ---------------------------------------------------------------------
    match /lecturer_verifications/{uid} {
      allow create, read, update, delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------
    // Users collection (mobile app students)
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Owners keep their existing behaviour (any Google account may
      // auto-provision a profile); authenticated lecturers can read any
      // student so the dashboard can list and inspect learners.
      allow read: if isOwner(userId) || isLecturer();
      allow create, update, delete: if isOwner(userId);

      match /rankHistory/{entryId} {
        allow read: if isOwner(userId) || isLecturer();
        allow create, update, delete: if isOwner(userId);
      }
    }

    // Public leaderboard profiles (mobile app)
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidPublicProfile();
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Question banks
    // ---------------------------------------------------------------------
    match /computer_architecture_questions/{questionId} {
      allow read: if true;
      // Students can't write; lecturers (via the dashboard) can manage questions.
      allow write: if isLecturer();
    }

    match /computer_networking_questions/{questionId} {
      allow read: if true;
      allow write: if isLecturer();
    }

    match /software_engineering_questions/{questionId} {
      allow read: if true;
      allow write: if isLecturer();
    }

    // ---------------------------------------------------------------------
    // Incorrect-question tracking (mobile app writes, dashboard reads)
    // ---------------------------------------------------------------------
    match /computer_architecture_questions_gotten_incorrectly/{questionId} {
      allow read: if isLecturer();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['questionId', 'number_of_wrong'])
        && request.resource.data.questionId == questionId
        && request.resource.data.number_of_wrong is int
        && (
          (!exists(/databases/$(database)/documents/computer_architecture_questions_gotten_incorrectly/$(questionId)) && request.resource.data.number_of_wrong == 1)
          || (exists(/databases/$(database)/documents/computer_architecture_questions_gotten_incorrectly/$(questionId))
              && request.resource.data.number_of_wrong == resource.data.number_of_wrong + 1)
        );
      allow delete: if false;
    }

    match /computer_networking_questions_gotten_incorrectly/{questionId} {
      allow read: if isLecturer();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['questionId', 'number_of_wrong'])
        && request.resource.data.questionId == questionId
        && request.resource.data.number_of_wrong is int
        && (
          (!exists(/databases/$(database)/documents/computer_networking_questions_gotten_incorrectly/$(questionId)) && request.resource.data.number_of_wrong == 1)
          || (exists(/databases/$(database)/documents/computer_networking_questions_gotten_incorrectly/$(questionId))
              && request.resource.data.number_of_wrong == resource.data.number_of_wrong + 1)
        );
      allow delete: if false;
    }

    match /software_engineering_questions_gotten_incorrectly/{questionId} {
      allow read: if isLecturer();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['questionId', 'number_of_wrong'])
        && request.resource.data.questionId == questionId
        && request.resource.data.number_of_wrong is int
        && (
          (!exists(/databases/$(database)/documents/software_engineering_questions_gotten_incorrectly/$(questionId)) && request.resource.data.number_of_wrong == 1)
          || (exists(/databases/$(database)/documents/software_engineering_questions_gotten_incorrectly/$(questionId))
              && request.resource.data.number_of_wrong == resource.data.number_of_wrong + 1)
        );
      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}