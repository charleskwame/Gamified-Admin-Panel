rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an authenticated lecturer
    function isAuthenticated() {
      return request.auth != null;
    }

    function isLecturer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        && get(/databases/$(database)/documents/lecturers/$(request.auth.uid)).data.role == "lecturer";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Lecturers collection: only the owning lecturer can read/write their own doc
    match /lecturers/{lecturerId} {
      allow read, write: if isOwner(lecturerId);
    }

    // Users collection (students): only authenticated lecturers can read.
    // Owners may also read their own document - this is needed for the legacy
    // migration path where old builds stored lecturer profiles inside `users`.
    match /users/{userId} {
      allow read: if isLecturer() || isOwner(userId);
      // Students should only be writable through the student app, not here
      allow write: if false;
    }

    // Questions collections: only lecturers can read/write
    match /computer_architecture_questions/{questionId} {
      allow read, write: if isLecturer();
    }

    match /computer_networking_questions/{questionId} {
      allow read, write: if isLecturer();
    }

    match /software_engineering_questions/{questionId} {
      allow read, write: if isLecturer();
    }

    // Incorrect questions tracking collections: lecturers can read
    match /computer_architecture_questions_gotten_incorrectly/{docId} {
      allow read: if isLecturer();
      allow write: if false;
    }

    match /computer_networking_questions_gotten_incorrectly/{docId} {
      allow read: if isLecturer();
      allow write: if false;
    }

    match /software_engineering_questions_gotten_incorrectly/{docId} {
      allow read: if isLecturer();
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}