# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Email domain allowed to sign in as a lecturer (Google sign-in)
# Only accounts ending in @<this domain> get a lecturer profile auto-created.
VITE_LECTURER_EMAIL_DOMAIN=st.atu.edu.gh

# DeepSeek API Key (preferred - for enhanced AI insights)
# DeepSeek provides more cost-effective and detailed analysis
# Get your API key from https://platform.deepseek.com
# VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (optional - alternative AI insights provider)
# If DeepSeek is not configured, this will be used as fallback
# VITE_OPENAI_API_KEY=your_openai_api_key_here
