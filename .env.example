# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# DeepSeek API Key (preferred - for enhanced AI insights)
# DeepSeek provides more cost-effective and detailed analysis
# Get your API key from https://platform.deepseek.com
# VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (optional - alternative AI insights provider)
# If DeepSeek is not configured, this will be used as fallback
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# EmailJS - sends the sign-up OTP verification emails
# Create a free account at https://www.emailjs.com, add an email service and a
# template with {{otp_code}}, {{to_email}} and {{to_name}} variables, then fill
# the three values below.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
